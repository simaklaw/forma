diff --git a/apps/web/src/components/ui/level.tsx b/apps/web/src/components/ui/level.tsx
new file mode 100644
index 0000000..611b5cc
--- /dev/null
+++ b/apps/web/src/components/ui/level.tsx
@@ -0,0 +1,22 @@
+import type { HTMLAttributes, ReactNode } from "react";
+import { cn } from "@/lib/utils";
+
+/** Horizontal metric row — Bulma-inspired level. */
+export function Level({ className, ...props }: HTMLAttributes<HTMLDivElement>) {
+  return <div className={cn("fp-level", className)} {...props} />;
+}
+
+export function LevelItem({
+  className,
+  heading,
+  title,
+  ...props
+}: HTMLAttributes<HTMLDivElement> & { heading?: string; title?: ReactNode }) {
+  return (
+    <div className={cn("fp-level-item", className)} {...props}>
+      {heading ? <span className="heading">{heading}</span> : null}
+      {title != null ? <span className="title">{title}</span> : null}
+      {props.children}
+    </div>
+  );
+}
diff --git a/apps/web/src/components/ui/notification.tsx b/apps/web/src/components/ui/notification.tsx
new file mode 100644
index 0000000..a4af531
--- /dev/null
+++ b/apps/web/src/components/ui/notification.tsx
@@ -0,0 +1,25 @@
+import type { HTMLAttributes } from "react";
+import { cn } from "@/lib/utils";
+
+type Tone = "default" | "accent" | "warn" | "danger";
+
+/** Soft status banner — Bulma-inspired notification. */
+export function Notification({
+  className,
+  tone = "default",
+  ...props
+}: HTMLAttributes<HTMLDivElement> & { tone?: Tone }) {
+  return (
+    <div
+      role="status"
+      className={cn(
+        "fp-notification",
+        tone === "accent" && "is-accent",
+        tone === "warn" && "is-warn",
+        tone === "danger" && "is-danger",
+        className,
+      )}
+      {...props}
+    />
+  );
+}
