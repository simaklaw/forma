{
  "name": "forma-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:gate": "prettier --check \"apps/mobile/src/features/workout/catalogBrowser.ts\" \"apps/mobile/src/features/workout/catalogBrowser.test.ts\" \"apps/mobile/src/features/workout/exerciseFavorites.ts\" \"apps/mobile/src/features/workout/exerciseFavorites.test.ts\""
  },
  "pnpm": {
    "overrides": {
      "react": "18.2.0",
      "@types/react": "18.2.79"
    }
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
