# Expo + React Native native builds need a flat node_modules layout.
# Isolated pnpm puts @react-native/gradle-plugin only under .pnpm/,
# and Expo's settings.gradle require.resolve then yields includeBuild(null).
# https://docs.expo.dev/guides/monorepos/
node-linker=hoisted

# Keep runtime react at the monorepo root (not only @types/react under apps/mobile).
public-hoist-pattern[]=*react*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native/*
