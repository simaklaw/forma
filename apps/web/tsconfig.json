{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@forma/core": ["../../packages/core/src"],
      "@forma/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
