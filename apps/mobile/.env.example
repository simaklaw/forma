# HTTPS URL to a compatible GGUF model. Do not commit the model itself.
# Example: a private artifact mirror or a Hugging Face resolve URL.
EXPO_PUBLIC_LLAMA_MODEL_URL=

# Optional: same UUID as expo.extra.eas.projectId (from `eas init`).
# EAS_PROJECT_ID=

# Sync API (P2 per-user JWT). Point to your API host; 10.0.2.2 = host loopback from Android emulator.
# EXPO_PUBLIC_SYNC_API_URL=http://10.0.2.2:8787
#
# No client token needed: on the first outbox drain the app registers an
# anonymous device identity (POST /api/v1/auth/register) and stores its
# per-user JWT in AsyncStorage. The JWT is re-registered automatically
# when it expires (30-day TTL), keeping the same server-side user_id.
#
# Legacy: EXPO_PUBLIC_SYNC_API_TOKEN (shared secret) is no longer used by
# the app; scripts/setup-sync-token.sh may still write it for older stacks.

# OIDC public client IDs (safe in the app bundle — not server secrets).
# Leave empty to hide VK / Mail.ru buttons; email link still works.
# EXPO_PUBLIC_OIDC_VK_CLIENT_ID=
# EXPO_PUBLIC_OIDC_MAILRU_CLIENT_ID=
