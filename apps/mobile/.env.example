# HTTPS URL to a compatible GGUF model. Do not commit the model itself.
# Example: a private artifact mirror or a Hugging Face resolve URL.
EXPO_PUBLIC_LLAMA_MODEL_URL=

# Optional: same UUID as expo.extra.eas.projectId (from `eas init`).
# EAS_PROJECT_ID=

# Sync API (P1). Point to your API host; 10.0.2.2 = host loopback from Android emulator.
# EXPO_PUBLIC_SYNC_API_URL=http://10.0.2.2:8787

# Shared-secret token — MUST match SYNC_API_TOKEN on the API server.
# Generate with: openssl rand -hex 32
# Do NOT commit the real value; keep it in .env (gitignored) or EAS secrets.
# EXPO_PUBLIC_SYNC_API_TOKEN=
