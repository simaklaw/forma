{
  "expo": {
    "name": "FitPulse",
    "slug": "fitpulse",
    "version": "0.1.0",
    "icon": "./assets/branding/fitpulse-icon.png",
    "newArchEnabled": false,
    "orientation": "portrait",
    "scheme": "fitpulse",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F14",
    "splash": {
      "image": "./assets/branding/fitpulse-splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.fitpulse.native"
    },
    "android": {
      "package": "app.fitpulse.native",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/fitpulse-adaptive-foreground.png",
        "backgroundColor": "#0B0F14"
      },
      "permissions": [
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "13.4" },
          "android": { "minSdkVersion": 24 }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0c01d915-9c7c-40d9-a691-959faeae7f13"
      }
    },
    "owner": "simaklaw"
  }
}
